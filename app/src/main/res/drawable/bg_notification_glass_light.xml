<?xml version="1.0" encoding="utf-8"?>
<!--
    Classic LIGHT call card: plain white with a single hairline. Used by the "Classic" look on light
    themes and by the "Light" look.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FFE1E5EC" />
        </shape>
    </item>
</layer-list>
