<?xml version="1.0" encoding="utf-8"?>
<!--
    Classic DARK call card: flat graphite with a single hairline. No gradient, no sheen, no tint.
    (v2.1: the old card was a teal diagonal gradient with a glossy band, which is what made the call
    notification look cartoony.) Used by the "Classic" look on dark themes and by the "Dark" look.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1D1F25" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FF2D3039" />
        </shape>
    </item>
</layer-list>
