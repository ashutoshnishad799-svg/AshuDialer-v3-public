<!--
  Wrapped in a ripple so tapping Mute/Speaker in the notification actually
  shows touch feedback. These buttons were always functionally clickable
  (setOnClickPendingIntent was correctly wired in CallNotificationHelper),
  but with a flat static <shape> as the only background there was no visual
  response to a tap, which read as unresponsive/"stuck on" rather than a
  real button - RippleDrawable is supported inside notification RemoteViews
  from API 24+ and this app's minSdk is 29, so it's safe unconditionally.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:endColor="#14FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
